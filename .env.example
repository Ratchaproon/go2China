# Required: Anthropic API key used by the agent (server-side only)
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Required in production: secret used to HMAC-sign the sandbox ledger state.
# Generate with: openssl rand -hex 32
LEDGER_SIGNING_SECRET=
